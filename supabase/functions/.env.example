# Segredos das Edge Functions. Localmente: copiar para supabase/functions/.env (não vai para o git).
# Em produção: Supabase → Edge Functions → Secrets (ou `supabase secrets set`).
# SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY são definidos pelo próprio Supabase.

# Resend (API key com permissão "Sending access"). Sem chave, o envio falha, exceto para os emails
# que ficam no log (EMAIL_MODE / EMAIL_LOG_DOMAINS).
RESEND_API_KEY=
# Local: escreve todos os emails no log da função em vez de os enviar.
EMAIL_MODE=log
# Só alguns domínios no log, separados por vírgulas; os restantes saem pela Resend. No projeto de
# desenvolvimento: exemplo.test (os endereços fictícios, usados pelo e2e). Vazio em produção.
EMAIL_LOG_DOMAINS=
# Endereço do portal nos links (só em desenvolvimento; em produção usa o hostname da organização).
PUBLIC_SITE_URL=http://localhost:5173
# Origens autorizadas a chamar invite-client (separadas por vírgulas).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Segredo do hook Send Email (formato v1,whsec_...), gerado no painel do Supabase.
SEND_EMAIL_HOOK_SECRET=
# Validade dos links de acesso, em horas (deve coincidir com Auth → Email OTP Expiration).
AUTH_LINK_EXPIRY_HOURS=1

# Limpeza: manter desativada até existir política de conservação aprovada e ensaio remoto.
RETENTION_ENABLED=false
# UUID da organização aprovada. Impede que uma tarefa afete outras organizações.
RETENTION_ORGANIZATION_ID=
# Segredo aleatório de pelo menos 32 caracteres, apenas no servidor e no Vault do agendador.
RETENTION_JOB_SECRET=
