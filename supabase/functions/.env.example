# Segredos das Edge Functions. Localmente: copiar para supabase/functions/.env (não vai para o git).
# Em produção: Supabase → Edge Functions → Secrets (ou `supabase secrets set`).
# SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY são definidos pelo próprio Supabase.

# Brevo (API key de transações). Sem chave, o envio falha, exceto com EMAIL_MODE=log.
BREVO_API_KEY=
# Local: escreve os emails no log da função em vez de os enviar.
EMAIL_MODE=log
# Endereço do portal nos links (só em desenvolvimento; em produção usa o hostname da organização).
PUBLIC_SITE_URL=http://localhost:5173
# Origens autorizadas a chamar invite-client (separadas por vírgulas).
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Segredo do hook Send Email (formato v1,whsec_...), gerado no painel do Supabase.
SEND_EMAIL_HOOK_SECRET=
# Validade dos links de acesso, em horas (deve coincidir com Auth → Email OTP Expiration).
AUTH_LINK_EXPIRY_HOURS=1
