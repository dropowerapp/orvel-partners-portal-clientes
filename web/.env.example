# Copiar para web/.env.local. Só valores públicos: a chave "anon"/"publishable" é pública por
# natureza (a segurança está na RLS). NUNCA colocar aqui a service_role nem outras chaves secretas.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# Modo de demonstração (só em `npm run dev`): Supabase simulado com dados fictícios, para ver os
# ecrãs sem projeto Supabase. Nunca tem efeito no build de produção.
# VITE_DEMO_MODE=true
